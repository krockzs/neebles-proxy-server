{
  "schema": 4,
  "name": "neebles-proxy-server",
  "version": "1.0.1",
  "entrypoint": "runtime/neebles-proxy-server",
  "lifecycle": "lifecycle.json",
  "surfaces": "surfaces.json",
  "contracts": [
    {
      "type": "commands",
      "file": "contracts/commands.json",
      "schema": 1,
      "enabled": true
    }
  ],
  "settings": "settings/default.json",
  "uninstall": {
    "schema": 1,
    "hardcoded": {
      "health_service": "neebles-neebles-proxy-server-health.service"
    },
    "main": "governor",
    "extras": [
      {
        "id": "proxy-health-daemon",
        "type": "service",
        "provider": "systemd-user",
        "name": "$hardcoded.health_service",
        "exec_start": "/opt/neebles/modules/neebles-proxy-server/runtime/neebles-proxy-server-health --policy /opt/neebles/modules/neebles-proxy-server/settings/allowlist.json --port 18879",
        "required": false,
        "stop": {
          "disable": true,
          "timeout_ms": 5000
        },
        "verify": "inactive",
        "remove": true
      }
    ],
    "cleanup": [
      {
        "id": "local-settings",
        "type": "settings",
        "ref": "manifest.settings",
        "policy": "user-choice"
      }
    ],
    "failure": {
      "unknown_process_owner": "abort",
      "resource_still_running": "abort",
      "cleanup_error": "abort"
    }
  }
}
